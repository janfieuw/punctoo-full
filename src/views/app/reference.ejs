<div class="grid2">
  <div class="card">
    <h2>Actieve instellingen</h2>
    <% if (!current) { %>
      <p class="muted">Nog geen referentie-instellingen.</p>
    <% } else { %>
      <div class="kpis">
        <div class="kpi">
          <div class="kpi-label">Referentieduur</div>
          <div class="kpi-value"><%= current.reference_days %> <span class="small">dagen</span></div>
        </div>
        <div class="kpi">
          <div class="kpi-label">Weekuren</div>
          <div class="kpi-value"><%= (current.weekly_minutes_target/60).toFixed(1) %> <span class="small">u</span></div>
        </div>
        <div class="kpi">
          <div class="kpi-label">Sinds</div>
          <div class="kpi-value"><%= current.effective_from %></div>
        </div>
      </div>
    <% } %>

    <div class="divider"></div>
    <h3>Nieuwe instellingen</h3>
    <% if (error) { %><div class="alert"><%= error %></div><% } %>

    <form method="post" action="/app/reference" class="form">
      <label>Referentieduur (dagen)</label>
      <input name="reference_days" type="number" min="7" max="366" value="<%= current ? current.reference_days : 91 %>" required />

      <label>Wekelijkse arbeidsduur (uren)</label>
      <input name="weekly_hours" type="number" step="0.5" min="0" value="<%= current ? (current.weekly_minutes_target/60).toFixed(1) : 38 %>" required />

      <label>Ingangsdatum</label>
      <input name="effective_from" type="date" value="<%= new Date().toISOString().slice(0,10) %>" required />

      <button class="btn btn-primary" type="submit"><i data-lucide="save"></i> Opslaan</button>
    </form>

    <p class="muted tiny">Nieuwe instellingen sluiten de vorige af (historiek blijft bewaard).</p>
  </div>

  <div class="card">
    <h2>Historiek</h2>
    <table class="table">
      <thead>
        <tr>
          <th>Van</th>
          <th>Tot</th>
          <th>Referentie</th>
          <th>Weekuren</th>
        </tr>
      </thead>
      <tbody>
        <% history.forEach(h => { %>
          <tr>
            <td><%= h.effective_from %></td>
            <td><%= h.effective_to || "—" %></td>
            <td><%= h.reference_days %> d</td>
            <td><%= (h.weekly_minutes_target/60).toFixed(1) %> u</td>
          </tr>
        <% }) %>
        <% if (!history.length) { %>
          <tr><td colspan="4" class="muted">Geen historiek.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
