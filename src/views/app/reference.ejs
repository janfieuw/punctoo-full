<%- include("../_layout_top", {
  title: title,
  chrome: chrome,
  badge: badge,
  topMeta: topMeta,
  logoutAction: logoutAction,
  tabs: tabs,
  subtabs: subtabs
}) %>

<div class="grid2">
  <div class="card">
    <h2>Actieve instellingen</h2>
    <% if (!current) { %>
      <p class="muted">Nog geen referentie-instellingen.</p>
    <% } else { %>
      <div class="kpis">
        <div class="kpi">
          <div class="kpi-label">Referentieduur</div>
          <div class="kpi-value"><%= current.reference_days %> <span class="muted">dagen</span></div>
        </div>
        <div class="kpi">
          <div class="kpi-label">Weekuren</div>
          <div class="kpi-value"><%= (current.weekly_minutes_target/60).toFixed(1) %> <span class="muted">u</span></div>
        </div>
        <div class="kpi">
          <div class="kpi-label">Sinds</div>
          <div class="kpi-value"><%= new Date(current.effective_from).toLocaleDateString('nl-BE') %></div>
        </div>
      </div>
    <% } %>

    <div class="divider"></div>

    <h3>Nieuwe instellingen</h3>

    <% if (error) { %>
      <div class="alert"><%= error %></div>
    <% } %>

    <form method="post" action="/app/reference" class="form">
      <div class="field">
        <label>Referentieduur (dagen)</label>
        <input type="number" name="reference_days" min="7" max="366" required />
      </div>

      <div class="field">
        <label>Wekelijkse arbeidsduur (uren)</label>
        <input type="number" name="weekly_hours" step="0.1" min="0" required />
      </div>

      <div class="field">
        <label>Ingangsdatum</label>
        <input type="date" name="effective_from" required />
      </div>

      <button class="btn btn-primary" type="submit"><i data-lucide="save"></i> Opslaan</button>
      <p class="muted" style="margin-top:8px;">Nieuwe instellingen sluiten de vorige af (historiek blijft bewaard).</p>
    </form>
  </div>

  <div class="card">
    <h2>Historiek</h2>
    <% if (!history || !history.length) { %>
      <p class="muted">Nog geen historiek.</p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr>
            <th>Van</th>
            <th>Tot</th>
            <th class="right">Referentie</th>
            <th class="right">Weekuren</th>
          </tr>
        </thead>
        <tbody>
          <% history.forEach(h => { %>
            <tr>
              <td><%= new Date(h.effective_from).toLocaleDateString('nl-BE') %></td>
              <td><%= h.effective_to ? new Date(h.effective_to).toLocaleDateString('nl-BE') : "—" %></td>
              <td class="right"><%= h.reference_days %> d</td>
              <td class="right"><%= (h.weekly_minutes_target/60).toFixed(1) %> u</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<%- include("../_layout_bottom") %>