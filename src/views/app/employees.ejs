<%- include("../_layout", {
  title: "Werknemers · MyPunctoo",
  chrome: true,
  badge: user.company_name,
  logoutAction: "/logout",
  tabs: [
    {href:"/app", label:"DASHBOARD", active:false},
    {href:"/app/employees", label:"WERKNEMERS", active:true},
    {href:"/app/reference", label:"REFERENTIE", active:false},
    {href:"/app/export", label:"EXPORT", active:false}
  ],
  topMeta: "Klant #" + user.company_number
}) %>

<div class="card">
  <div class="row">
    <div>
      <h2>Werknemers</h2>
      <p class="muted">Onbeperkt. Per werknemer blijft de koppelcode zichtbaar.</p>
    </div>
    <div class="hint">Tip: gebruik korte numerieke codes (bv. 1234).</div>
  </div>

  <% if (error) { %><div class="alert"><%= error %></div><% } %>

  <form method="post" action="/app/employees/add" class="form inline">
    <div class="field">
      <label>Naam</label>
      <input name="name" placeholder="Naam werknemer" required />
    </div>
    <div class="field">
      <label>Koppelcode</label>
      <input name="coupling_code" placeholder="bv. 1234" required />
    </div>
    <button class="btn btn-primary" type="submit"><i data-lucide="plus"></i> Toevoegen</button>
  </form>

  <table class="table">
    <thead>
      <tr>
        <th>Naam</th>
        <th>Koppelcode</th>
        <th>Status</th>
        <th class="right">Acties</th>
      </tr>
    </thead>
    <tbody>
      <% employees.forEach(e => { %>
        <tr>
          <td>
            <form method="post" action="/app/employees/<%= e.id %>/rename" class="inline-rename">
              <input name="display_name" value="<%= e.display_name %>" />
              <button class="btn btn-ghost" type="submit" title="Opslaan"><i data-lucide="save"></i></button>
            </form>
          </td>
          <td><span class="mono"><%= e.coupling_code %></span></td>
          <td><span class="pill <%= e.status === 'active' ? 'ok' : 'muted' %>"><%= e.status %></span></td>
          <td class="right">
            <form method="post" action="/app/employees/<%= e.id %>/toggle">
              <button class="btn btn-ghost" type="submit">
                <i data-lucide="<%= e.status === 'active' ? 'user-x' : 'user-check' %>"></i>
                <%= e.status === 'active' ? 'Deactiveren' : 'Activeren' %>
              </button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!employees.length) { %>
        <tr><td colspan="4" class="muted">Nog geen werknemers.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
