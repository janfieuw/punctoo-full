<%- include("../_layout_top", {
  title: title,
  chrome: chrome,
  badge: badge,
  topMeta: topMeta,
  logoutAction: logoutAction,
  tabs: tabs,
  subtabs: subtabs
}) %>

<div class="grid2">
  <div class="card">
    <h2>Overzicht</h2>
    <div class="kpis">
      <div class="kpi">
        <div class="kpi-label">Actieve werknemers</div>
        <div class="kpi-value"><%= empCount %></div>
      </div>

      <% if (ref) { %>
        <div class="kpi">
          <div class="kpi-label">Referentieduur</div>
          <div class="kpi-value"><%= ref.reference_days %> <span class="muted">dagen</span></div>
        </div>
        <div class="kpi">
          <div class="kpi-label">Weekuren</div>
          <div class="kpi-value"><%= (ref.weekly_minutes_target/60).toFixed(1) %> <span class="muted">u</span></div>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <h2>Transparantie (laatste <%= ref ? ref.reference_days : 0 %> dagen)</h2>

    <% if (!balance) { %>
      <p class="muted">Nog geen referentie-instellingen of geen data.</p>
    <% } else { %>
      <div class="kpis">
        <div class="kpi">
          <div class="kpi-label">Gewerkt</div>
          <div class="kpi-value"><%= (balance.workedMin/60).toFixed(0) %>u</div>
        </div>
        <div class="kpi">
          <div class="kpi-label">Doel</div>
          <div class="kpi-value"><%= (balance.targetMin/60).toFixed(0) %>u</div>
        </div>
        <div class="kpi">
          <div class="kpi-label">Saldo</div>
          <div class="kpi-value"><%= balance.diffHHMM %></div>
        </div>
      </div>
      <p class="muted" style="margin-top:8px;">
        Eenvoudige berekening op basis van IN→OUT paren. Geen automatische correcties.
      </p>
    <% } %>
  </div>
</div>

<div class="card">
  <h2>Laatste scans</h2>

  <% if (!lastScans || !lastScans.length) { %>
    <p class="muted">Nog geen scans.</p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th>Tijd</th>
          <th>Werknemer</th>
          <th>Type</th>
          <th>Locatie</th>
        </tr>
      </thead>
      <tbody>
        <% lastScans.forEach(s => { %>
          <tr>
            <td><%= new Date(s.scanned_at).toLocaleString('nl-BE') %></td>
            <td><%= s.display_name %></td>
            <td><span class="pill <%= s.scan_type === 'IN' ? 'in' : 'out' %>"><%= s.scan_type %></span></td>
            <td><%= s.location_label || "—" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include("../_layout_bottom") %>