<div class="card">
  <h2>Download scanlog</h2>
  <p class="muted">Export als CSV (geschikt voor inspectie, boekhouder, eigen analyse).</p>

  <form method="get" action="/app/export/events.csv" class="form inline">
    <div class="field">
      <label>Van</label>
      <input type="date" name="from" required />
    </div>
    <div class="field">
      <label>Tot</label>
      <input type="date" name="to" required />
    </div>
    <button class="btn btn-primary" type="submit">
      <i data-lucide="download"></i> Download CSV
    </button>
  </form>
</div>
