<%- include("../_layout_top", {
  title: title,
  chrome: chrome,
  badge: badge,
  topMeta: topMeta,
  logoutAction: logoutAction,
  tabs: tabs,
  subtabs: subtabs
}) %>

<div class="card">
  <h2>Export</h2>
  <p class="muted">Download scan events als CSV.</p>

  <form method="get" action="/app/export/events.csv" class="form inline" style="margin-top: 12px;">
    <div class="field">
      <label>Van</label>
      <input type="date" name="from" required />
    </div>
    <div class="field">
      <label>Tot</label>
      <input type="date" name="to" required />
    </div>
    <button class="btn btn-primary" type="submit"><i data-lucide="download"></i> Download CSV</button>
  </form>
</div>

<%- include("../_layout_bottom") %>