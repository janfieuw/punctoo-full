<%- include("../_layout_top", {
  title: title,
  chrome: chrome,
  badge: badge,
  topMeta: topMeta,
  logoutAction: logoutAction,
  tabs: tabs,
  subtabs: subtabs
}) %>

<div class="card">
  <div class="row">
    <div>
      <h2>Balans per dag</h2>
      <p class="muted">Werkelijk = (eerste IN → laatste OUT). Verwacht = referentieduur (minuten). Override wint van weekpatroon.</p>
    </div>

    <div class="row right">
      <% if (employee) { %>
        <a class="btn btn-ghost" href="/app/balance.csv?employee_id=<%= selectedEmployeeId %>&from=<%= selectedFrom %>&to=<%= selectedTo %>">
          <i data-lucide="download"></i> CSV
        </a>
      <% } %>
    </div>
  </div>

  <form method="get" action="/app/balance" class="form inline">
    <div class="field">
      <label>Werknemer</label>
      <select name="employee_id">
        <% employees.forEach(e => { %>
          <option value="<%= e.id %>" <%= e.id === selectedEmployeeId ? "selected" : "" %>><%= e.display_name %></option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label>Van</label>
      <input type="date" name="from" value="<%= selectedFrom %>" required />
    </div>

    <div class="field">
      <label>Tot</label>
      <input type="date" name="to" value="<%= selectedTo %>" required />
    </div>

    <button class="btn btn-primary" type="submit"><i data-lucide="search"></i> Tonen</button>
  </form>

  <% if (!employee) { %>
    <div class="alert">Geen werknemer geselecteerd of geen actieve werknemers.</div>
  <% } else { %>

    <div class="divider"></div>

    <div class="kpis">
      <div class="kpi">
        <div class="kpi-label">Dagen met resultaat</div>
        <div class="kpi-value"><%= totals.days %></div>
      </div>
      <div class="kpi">
        <div class="kpi-label">Gewerkt</div>
        <div class="kpi-value"><%= mmToHHMM(totals.worked) %></div>
      </div>
      <div class="kpi">
        <div class="kpi-label">Verwacht</div>
        <div class="kpi-value"><%= mmToHHMM(totals.expected) %></div>
      </div>
      <div class="kpi">
        <div class="kpi-label">Saldo</div>
        <div class="kpi-value"><%= mmToHHMM(totals.delta) %></div>
      </div>
    </div>

    <div class="divider"></div>

    <table class="table">
      <thead>
        <tr>
          <th>Datum</th>
          <th class="right">Verwacht</th>
          <th>Bron</th>
          <th>IN</th>
          <th>OUT</th>
          <th class="right">Gewerkt</th>
          <th class="right">Saldo</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(r => { %>
          <tr>
            <td><%= r.ref_date %></td>
            <td class="right"><span class="mono"><%= r.expected_minutes %>m</span></td>
            <td><span class="pill <%= r.expected_source === 'override' ? 'in' : (r.expected_source === 'weekday' ? 'ok' : 'muted') %>"><%= r.expected_source %></span></td>
            <td><%= r.first_in ? new Date(r.first_in).toLocaleTimeString('nl-BE', { hour: '2-digit', minute: '2-digit' }) : "—" %></td>
            <td><%= r.last_out ? new Date(r.last_out).toLocaleTimeString('nl-BE', { hour: '2-digit', minute: '2-digit' }) : "—" %></td>
            <td class="right"><span class="mono"><%= r.worked_minutes === null ? "—" : (mmToHHMM(r.worked_minutes)) %></span></td>
            <td class="right"><span class="mono"><%= r.delta_minutes === null ? "—" : (mmToHHMM(r.delta_minutes)) %></span></td>
            <td><span class="pill <%= r.status === 'OK' ? 'ok' : 'muted' %>"><%= r.status %></span></td>
          </tr>
        <% }) %>

        <% if (!rows.length) { %>
          <tr><td colspan="8" class="muted">Geen data in deze periode.</td></tr>
        <% } %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include("../_layout_bottom") %>