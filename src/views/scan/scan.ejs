<%- include("../_layout", {
  title: "Scan " + scanType + " · Punctoo",
  chrome: true,
  badge: tag.company_name,
  logoutAction: null,
  tabs: [{href:"#", label:"SCAN " + scanType, active:true}],
  topMeta: tag.location_label ? ("Locatie: " + tag.location_label) : ""
}) %>

<div class="card narrow">
  <h1>Scan <span class="pill <%= scanType === 'IN' ? 'in' : 'out' %>"><%= scanType %></span></h1>
  <p class="muted">Vul je <b>koppelcode</b> in en bevestig.</p>

  <% if (error) { %><div class="alert"><%= error %></div><% } %>

  <form method="post" class="form">
    <label>Koppelcode</label>
    <input name="coupling_code" inputmode="numeric" placeholder="bv. 1234" required />
    <button class="btn btn-primary" type="submit">
      <i data-lucide="check"></i> Bevestigen
    </button>
  </form>

  <div class="divider"></div>
  <details>
    <summary class="muted">Werknemerslijst (optioneel)</summary>
    <div class="chips">
      <% employees.forEach(e => { %>
        <span class="chip"><%= e.display_name %> · <span class="mono"><%= e.coupling_code %></span></span>
      <% }) %>
    </div>
  </details>
</div>
